{
  "name": "wallet",
  "private": true,
  "version": "0.2.8",
  "main": "electron/main.js",
  "scripts": {
    "dev": "vite",
    "build": "tsc && node scripts/licenses.mjs && vite build",
    "electron:build": "npm run build && electron-builder --win nsis --publish never",
    "preview": "vite preview",
    "test": "vitest run",
    "mobile:sync": "npm run build && cap sync",
    "android": "npm run mobile:sync && cap open android",
    "ios": "npm run mobile:sync && cap open ios",
    "version:set": "node scripts/set-version.mjs",
    "release": "node scripts/release.mjs",
    "demo:build": "vite build --mode demo --outDir ../website/demo --emptyOutDir",
    "android:apk": "npm run mobile:sync && node scripts/android-apk.mjs"
  },
  "dependencies": {
    "@capacitor-community/admob": "^8.4.2",
    "@capacitor/android": "^8.6.2",
    "@capacitor/app": "^8.1.2",
    "@capacitor/app-launcher": "^8.0.1",
    "@capacitor/browser": "^8.0.5",
    "@capacitor/core": "^8.6.2",
    "@capacitor/ios": "^8.6.2",
    "@supabase/supabase-js": "^2.119.0",
    "date-fns": "^4.4.0",
    "dexie": "^4.4.7",
    "electron-updater": "^6.8.11",
    "flag-icons": "^7.6.0",
    "i18next": "^27.1.1",
    "pdfjs-dist": "^6.5.438",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-i18next": "^18.0.1",
    "react-router-dom": "^7.18.5",
    "recharts": "^3.10.1",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.6.2",
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "electron": "^45.3.2",
    "electron-builder": "^26.18.0",
    "fake-indexeddb": "^6.2.8",
    "playwright": "^1.65.0",
    "tailwindcss": "^4.3.5",
    "typescript": "~7.0.2",
    "vite": "^8.3.6",
    "vitest": "^5.1.0"
  }
}
